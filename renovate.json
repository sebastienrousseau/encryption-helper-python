{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group dev tooling into one PR; these bumps are noise individually. Of the 86 commits in this repository before v0.1.0, 32 were ungrouped bot commits.",
      "matchDepTypes": ["dev", "devDependencies"],
      "groupName": "dev dependencies",
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Group GitHub Actions digest updates.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "cryptography is the one runtime dependency and the security-critical one. Never automerge it; a human reads the changelog.",
      "matchPackageNames": ["cryptography"],
      "automerge": false,
      "labels": ["dependencies", "security-review"]
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  }
}
