# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# dotenv
.env

# virtualenv
.venv
.pain001/
.pytest_cache/
bandit-env
myenv
venv/
ENV/
pyvenv.cfg

# Spyder project settings
.spyderproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# PyCharm IDE
.idea/

# Type-checking
.pytype/

# macOS
.DS_Store

# VSCode
.vscode/
.vscode/settings.json

# Database
*.db-shm
*.db-wal

# ---------------------------------------------------------------------------
# Key material -- never commit secrets.
# The `detect-private-key` pre-commit hook is a second line of defence.
# ---------------------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*.jks
*.der
*.asc
*.gpg
id_rsa*
id_ed25519*
id_ecdsa*

# Explicitly allow non-secret fixtures used by the test suite.
!tests/fixtures/**/*.pem
!tests/fixtures/**/*.der
build/

# mutmut scratch output
mutants/
.mutmut-cache
